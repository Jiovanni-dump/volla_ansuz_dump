/dts-v1/;

/ {
	model = "MT6878";
	compatible = "mediatek,MT6878";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@11c20000";
		i2c1 = "/soc/i2c@11c21000";
		i2c2 = "/soc/i2c@11c22000";
		i2c3 = "/soc/i2c@11e00000";
		i2c4 = "/soc/i2c@11c23000";
		i2c5 = "/soc/i2c@11280000";
		i2c6 = "/soc/i2c@11e01000";
		i2c7 = "/soc/i2c@11e02000";
		i2c8 = "/soc/i2c@11e03000";
		i2c9 = "/soc/i2c@11c24000";
		i2c10 = "/soc/i2c@11d70000";
		i2c11 = "/soc/i2c@11d71000";
		i2c12 = "/soc/i2c@11d72000";
		ovl3 = "/soc/disp-ovl0-2l@14002000";
		ovl4 = "/soc/disp-ovl1-2l@14003000";
		ovl5 = "/soc/disp-ovl2-2l@14004000";
		ovl6 = "/soc/disp-ovl3-2l@14005000";
		tdshp0 = "/soc/disp-tdshp0@14009000";
		tdshp1 = "/soc/disp-tdshp1@14012000";
		color0 = "/soc/disp-color0@1400b000";
		ccorr0 = "/soc/disp-ccorr0@1400c000";
		ccorr1 = "/soc/disp-ccorr1@1400d000";
		ccorr2 = "/soc/disp-ccorr2@14014000";
		ccorr3 = "/soc/disp-ccorr3@14015000";
		c3d0 = "/soc/disp-c3d0@1400a000";
		c3d1 = "/soc/disp-c3d1@14013000";
		aal0 = "/soc/disp-aal0@1400e000";
		gamma0 = "/soc/disp-gamma0@1400f000";
		gamma1 = "/soc/disp-gamma1@14016000";
		dither0 = "/soc/disp-dither0@14011000";
		dither1 = "/soc/disp-dither1@14017000";
		dsi0 = "/soc/dsi0@1401a000";
		dsi1 = "/soc/dsi1@1401b000";
		mutex0 = "/soc/disp-mutex0@14001000";
		mtksmmu0 = "/soc/iommu@1e802000";
		mtksmmu1 = "/soc/iommu@19010000";
		wdma1 = "/soc/disp-wdma1@1401c000";
		rsz0 = "/soc/disp-rsz0@14008000";
		rsz1 = "/soc/disp-rsz1@14007000";
		postmask0 = "/soc/disp-postmask0@14010000";
		dsc0 = "/soc/disp-dsc-wrap0@14019000";
	};

	clkbuf-ctrl {
		compatible = "mediatek,mt6878-clkbuf";
		pmic = <0x02>;
		srclken-rc = <0x03>;
		pmif = <0x04>;
		phandle = <0x13c>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    nosoftlockup \t\t\t    8250.nr_uarts=3\t\t\t    androidboot.hardware=mt6878 \t\t\t    vmalloc=400M swiotlb=noforce \t\t\t    transparent_hugepage=never \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    firmware_class.path=/vendor/firmware ";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x99>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x10b>;
			phandle = <0x0e>;
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x10b>;
			phandle = <0x0f>;
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x10b>;
			phandle = <0x10>;
		};

		cpu@3 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x10b>;
			phandle = <0x11>;
		};

		cpu@100 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x12>;
		};

		cpu@101 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x13>;
		};

		cpu@102 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x14>;
		};

		cpu@103 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x15>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core3 {
					cpu = <0x11>;
				};

				doe {
					phandle = <0x13d>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core3 {
					cpu = <0x15>;
				};

				doe {
					phandle = <0x13e>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x19>;
				exit-latency-us = <0x39>;
				min-residency-us = <0x1644>;
				phandle = <0x06>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x23>;
				exit-latency-us = <0x52>;
				min-residency-us = <0x762>;
				phandle = <0x0b>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x39>;
				exit-latency-us = <0x86>;
				min-residency-us = <0x1644>;
				phandle = <0x07>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x90>;
				min-residency-us = <0x99c>;
				phandle = <0x0c>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x35f>;
				exit-latency-us = <0x4d5>;
				min-residency-us = <0x1644>;
				phandle = <0x08>;
			};

			mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x288>;
				exit-latency-us = <0x494>;
				min-residency-us = <0x11da>;
				phandle = <0x0d>;
			};

			system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20100ff>;
				local-timer-stop;
				entry-latency-us = <0x960>;
				exit-latency-us = <0x12c0>;
				min-residency-us = <0x8980>;
				phandle = <0x09>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x0a>;
			};
		};
	};

	atf-logger {
		compatible = "mediatek,tfa_debug";
		phandle = <0x13f>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	interrupt-controller@c000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04 0x00>;
		phandle = <0x01>;

		ppi-partitions {

			interrupt-partition-0 {
				affinity = <0x0e 0x0f 0x10 0x11>;
				phandle = <0x1f>;
			};

			interrupt-partition-1 {
				affinity = <0x12 0x13 0x14 0x15>;
				phandle = <0x20>;
			};
		};
	};

	logstore {
		enabled = <0x01>;
		pmic-register = <0xa0d>;
		phandle = <0x140>;
	};

	dcm@c530000 {
		compatible = "mediatek,mt6878-dcm";
		reg = <0x00 0xc530000 0x00 0xc8a0 0x00 0x10001000 0x00 0xa40 0x00 0x10022000 0x00 0x40 0x00 0x11035000 0x00 0x30 0x00 0x1c017000 0x00 0xc0>;
		reg-names = "mcusys_par_wrap\0infracfg_ao\0infra_ao_bcrm\0peri_ao_bcrm\0vlp_ao_bcrm";
		phandle = <0x141>;
	};

	mcupm@c540000 {
		compatible = "mediatek,mcupm";
		reg = <0x00 0xc540000 0x00 0x22000 0x00 0xc56fb00 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fba0 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fc40 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fce0 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fd80 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fe20 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fec0 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56ff60 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04>;
		reg-names = "mcupm_base\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox0_send\0mbox0_recv\0mbox1_base\0mbox1_set\0mbox1_clr\0mbox1_send\0mbox1_recv\0mbox2_base\0mbox2_set\0mbox2_clr\0mbox2_send\0mbox2_recv\0mbox3_base\0mbox3_set\0mbox3_clr\0mbox3_send\0mbox3_recv\0mbox4_base\0mbox4_set\0mbox4_clr\0mbox4_send\0mbox4_recv\0mbox5_base\0mbox5_set\0mbox5_clr\0mbox5_send\0mbox5_recv\0mbox6_base\0mbox6_set\0mbox6_clr\0mbox6_send\0mbox6_recv\0mbox7_base\0mbox7_set\0mbox7_clr\0mbox7_send\0mbox7_recv";
		interrupts = <0x00 0x18 0x04 0x00 0x00 0x19 0x04 0x00 0x00 0x1a 0x04 0x00 0x00 0x1b 0x04 0x00 0x00 0x1c 0x04 0x00 0x00 0x1d 0x04 0x00 0x00 0x1e 0x04 0x00 0x00 0x1f 0x04 0x00>;
		interrupt-names = "mbox0\0mbox1\0mbox2\0mbox3\0mbox4\0mbox5\0mbox6\0mbox7";
		phandle = <0x93>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};

	odm {
		compatible = "simple-bus";
		phandle = <0x142>;
	};

	uarthub {
		compatible = "mediatek,mt6878-uarthub";
		uarthub-disable = <0x01>;
		phandle = <0x143>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x144>;

		ccci-dpmaif-cache-memory {
			compatible = "mediatek,dpmaif-resv-cache-mem";
			size = <0x00 0x190000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xf0000000>;
			phandle = <0x145>;
		};

		ccci-dpmaif-nocache-memory {
			compatible = "mediatek,dpmaif-resv-nocache-mem";
			no-map;
			size = <0x00 0x50000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xf0000000>;
			phandle = <0x146>;
		};

		ssmr-reserved-cma-memory {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x10000000>;
			alignment = <0x00 0x1000000>;
			phandle = <0x1e>;
		};
	};

	oled_node {
		compatible = "coosea,oled";
		phandle = <0x147>;
	};

	qos@11bb00 {
		compatible = "mediatek,mt6893-qos";
		reg = <0x00 0x11bb00 0x00 0x100 0x00 0x11b9c0 0x00 0x140>;
		reg-names = "sram\0share_sram";
		mediatek,enable = <0x01>;
		phandle = <0x148>;
	};

	cm-mgr@c531000 {
		compatible = "mediatek,mt6878-cm_mgr";
		reg = <0x00 0xc531000 0x00 0x8000>;
		reg-names = "cm_mgr_base";
		interconnects = <0x16 0x03 0x16 0x00>;
		interconnect-names = "cm-perf-bw";
		required-opps = <0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d>;
		cm-mgr-enable = <0x01>;
		cm-mgr-arch = "v1p";
		cm-mgr-num-array = <0x07>;
		cm-mgr,cp-down = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		cm-mgr,cp-up = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		cm-mgr,dt-down = <0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		cm-mgr,dt-up = <0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		cm-mgr,vp-down = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		cm-mgr,vp-up = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		use-cpu-to-dram-map = "enable";
		use-cpu-to-dram-map-new = "enable";
		cm-mgr-cpu-opp-to-dram = <0x01 0x01 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08>;
		cm-perf-mode-enable = <0x01>;
		cm-perf-mode-ceiling-opp = <0x00>;
		cm-perf-mode-thd = <0x05>;
		phandle = <0x149>;
	};

	fpsgo {
		compatible = "mediatek,fpsgo";
		interconnects = <0x16 0x01 0x16 0x00>;
		interconnect-names = "fpsgo-perf-bw";
		required-opps = <0x17>;
		cpu-limit = <0x02>;
		gcc-enable = <0x01>;
		fbt-cpu-mask = <0xff 0xf0 0x0f 0x0f 0xf0 0xf0>;
		sbe-resceue-enable = <0x01>;
		phandle = <0x14a>;
	};

	efuse@11f10000 {
		compatible = "mediatek,devinfo";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x14b>;

		segment@78 {
			reg = <0x78 0x04>;
			phandle = <0xb2>;
		};

		u2-phy-data@334 {
			reg = <0x334 0x04>;
			phandle = <0xdb>;
		};

		cpu-data@234 {
			reg = <0x234 0x04>;
			phandle = <0x14c>;
		};

		lkg@218 {
			reg = <0x218 0x18>;
			phandle = <0x14d>;
		};

		csi-data0@320 {
			reg = <0x320 0x04>;
			phandle = <0x14e>;
		};

		csi-data1@324 {
			reg = <0x324 0x04>;
			phandle = <0x14f>;
		};

		csi-data2@328 {
			reg = <0x328 0x04>;
			phandle = <0x150>;
		};

		csi-data3@32c {
			reg = <0x32c 0x04>;
			phandle = <0x151>;
		};

		data1@1ac {
			reg = <0x1ac 0x30>;
			phandle = <0x8e>;
		};

		data2@140 {
			reg = <0x140 0x14>;
			phandle = <0x8f>;
		};

		data3@310 {
			reg = <0x310 0x0c>;
			phandle = <0x90>;
		};

		data4@2d8 {
			reg = <0x2d8 0x04>;
			phandle = <0x91>;
		};
	};

	thermal-ntc1@1c013128 {
		compatible = "mediatek,mt6685-tia-ntc";
